{
  "name": "drip-clash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DRIP CLASH – 3v3 paint brawler with lanes, towers and heroes (3D, landscape, mobile-first)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@fontsource/fredoka": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
